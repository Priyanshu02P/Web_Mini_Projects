PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173

# Self-hosted MongoDB credentials used by docker-compose.yml
MONGO_ROOT_USERNAME=todo_admin
MONGO_ROOT_PASSWORD=change_me_todo_db
# Docker Compose configures MONGO_URI to connect to the mongo service.
# For running the backend outside Docker, use:
# MONGO_URI=mongodb://127.0.0.1:27017/todo-app

# --- AI features (Smart Fill + Plan my day), powered by Groq ---
# Get a free key at https://console.groq.com/keys. Leave empty to hide the AI UI.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
