PORT=4000
JWT_SECRET=learning-project-secret-change-me
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string.
# Local dev (MongoDB running on your machine): mongodb://127.0.0.1:27017/todo-app
# Docker Compose (see docker-compose.yml):     mongodb://mongo:27017/todo-app
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/todo-app
MONGO_URI=mongodb://127.0.0.1:27017/todo-app
